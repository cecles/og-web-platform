{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "og-web-platform",
  "main": "src/App.tsx",
  "compatibility_date": "2026-09-29",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": []
  }
}
